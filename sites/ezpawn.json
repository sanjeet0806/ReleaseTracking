{
  "id": "ezpawn",
  "name": "EZPAWN Online Catalog",
  "baseUrl": "https://shop.ezpawn.com",
  "environment": "production",
  "features": {
    "zipRadiusSearch": true,
    "fulfillment": [
      "pickup",
      "shipping"
    ],
    "searchApp": "wizzy"
  },
  "keyPages": [
    {
      "name": "Home",
      "path": "/",
      "expectText": [
        "Why Buy From Us",
        "Find A Shop",
        "Store Inventory"
      ]
    },
    {
      "name": "All products",
      "path": "/collections/all"
    },
    {
      "name": "Online exclusives",
      "path": "/collections/online-exclusives"
    },
    {
      "name": "Jewelry",
      "path": "/collections/jewelry"
    },
    {
      "name": "Electronics",
      "path": "/collections/electronics"
    },
    {
      "name": "Search results",
      "path": "/search?q=ring"
    },
    {
      "name": "Cart",
      "path": "/cart"
    },
    {
      "name": "FAQ",
      "path": "/pages/faq",
      "contentBaseline": true
    },
    {
      "name": "Shop online",
      "path": "/pages/shop-online"
    },
    {
      "name": "Why buy from us",
      "path": "/pages/why-ezpawn",
      "contentBaseline": true
    },
    {
      "name": "Show me how",
      "path": "/pages/show-me-how",
      "contentBaseline": true
    },
    {
      "name": "Contact us",
      "path": "/pages/contact-us"
    },
    {
      "name": "About us",
      "path": "/pages/about-us",
      "contentBaseline": true
    },
    {
      "name": "Store pickup policy (old URL)",
      "path": "/pages/store-pick-up-policy",
      "expectStatus": 301,
      "expectRedirectTo": "/pages/show-me-how",
      "knownFinding": "QA-009"
    },
    {
      "name": "Refund policy",
      "path": "/policies/refund-policy",
      "contentBaseline": true
    },
    {
      "name": "Terms of service",
      "path": "/policies/terms-of-service",
      "contentBaseline": true
    },
    {
      "name": "Privacy policy",
      "path": "/policies/privacy-policy",
      "contentBaseline": true
    }
  ],
  "keyCollections": [
    "all",
    "online-exclusives",
    "jewelry",
    "electronics",
    "tools",
    "gaming",
    "musical-instruments-and-accessories"
  ],
  "sampling": {
    "productsPerRun": 10,
    "maxCatalogPage": 100,
    "storePages": {
      "pattern": "^/pages/store_\\d+$",
      "perRun": 10
    }
  },
  "catalog": {
    "requiredProductFields": [
      "title",
      "handle",
      "vendor",
      "product_type",
      "body_html",
      "images",
      "price",
      "sku"
    ],
    "requiredTagPrefixes": [
      "Store_",
      "state_",
      "city_",
      "Category_"
    ],
    "forbiddenTagPrefixes": [
      "Serial#"
    ],
    "currency": "USD",
    "locale": "en-US",
    "priceInHtml": false
  },
  "structuredData": {
    "allowRatings": false
  },
  "search": {
    "terms": [
      "ring",
      "iphone",
      "drill"
    ],
    "noResultTerm": "zzqxjvnoresultqa"
  },
  "knownIssues": [
    {
      "match": "Structured data URL",
      "id": "QA-001"
    },
    {
      "match": "includes ratings or reviews",
      "id": "QA-002"
    },
    {
      "match": "Public product data includes \"Serial#\"",
      "id": "QA-004"
    },
    {
      "match": "Product field \"product_type\" is blank",
      "id": "QA-010"
    }
  ],
  "contentMasks": [
    "\\u00a9\\s*\\d{4}",
    "copyright\\s*\\d{4}"
  ],
  "leftoverPagePatterns": [
    "(^|-)test(-|$)",
    "^copy-of",
    "lorem",
    "(^|-)draft(-|$)",
    "^untitled"
  ],
  "run": {
    "minRequestIntervalMs": 1000,
    "userAgent": "Mozilla/5.0 (compatible; EZQA-Automation/0.1)",
    "maxResponseMs": 5000
  },
  "leftoverPageAllow": []
}
