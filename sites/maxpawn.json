{
  "id": "maxpawn",
  "name": "Max Pawn",
  "baseUrl": "https://maxpawn.com",
  "environment": "production",
  "features": { "zipRadiusSearch": false, "fulfillment": ["shipping"], "searchApp": "wizzy" },
  "keyPages": [
    { "name": "Home", "path": "/" },
    { "name": "All products", "path": "/collections/all-products" },
    { "name": "Handbags", "path": "/collections/handbags" },
    { "name": "Jewelry", "path": "/collections/jewelry" },
    { "name": "Watches", "path": "/collections/watches" },
    { "name": "Designers", "path": "/collections/designers" },
    { "name": "Search results", "path": "/search?q=gucci" },
    { "name": "Cart", "path": "/cart" },
    { "name": "Login", "path": "/account/login" },
    { "name": "About us", "path": "/pages/about-us", "contentBaseline": true },
    { "name": "Authenticity", "path": "/pages/authenticity", "contentBaseline": true },
    { "name": "Layaway", "path": "/pages/10x10x10-layaway", "contentBaseline": true },
    { "name": "Sahara Ave store", "path": "/pages/locations-sahara-ave-las-vegas", "contentBaseline": true },
    { "name": "Decatur Blvd store", "path": "/pages/locations-decatur-blvd-las-vegas", "contentBaseline": true },
    { "name": "Durango store", "path": "/pages/locations-durango-las-vegas", "contentBaseline": true },
    { "name": "Miami Beach store", "path": "/pages/1452-washington-ave-miami-beach", "contentBaseline": true },
    { "name": "Refund policy", "path": "/policies/refund-policy", "contentBaseline": true },
    { "name": "Shipping policy", "path": "/policies/shipping-policy", "contentBaseline": true }
  ],
  "keyCollections": ["all-products", "handbags", "jewelry", "watches", "designers", "accessories", "shoes", "on-sale"],
  "sampling": { "productsPerRun": 10, "maxCatalogPage": 15 },
  "catalog": {
    "requiredProductFields": ["title", "handle", "vendor", "images", "price", "sku"],
    "requiredTagPrefixes": ["Category_"]
  },
  "structuredData": { "allowRatings": false },
  "search": { "terms": ["gucci", "rolex", "louis vuitton"], "noResultTerm": "zzqxjvnoresultqa" },
  "leftoverPagePatterns": ["(^|-)test(-|$)", "^copy-of", "lorem", "(^|-)draft(-|$)", "^untitled"],
  "run": {
    "minRequestIntervalMs": 1000,
    "userAgent": "Mozilla/5.0 (compatible; EZQA-Automation/0.1)"
  }
}
